{
  "expo": {
    "name": "axi",
    "slug": "axi",
    "scheme": "axi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nadhir-off.axi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.nadhir_off.axi",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "axi utilise l'appareil photo pour ajouter vos produits.",
          "photosPermission": "axi accède à vos photos pour ajouter vos produits.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "axi utilise le micro pour la recherche vocale et les messages vocaux."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#C2410C"
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cd06f786-fe9d-4c53-98a0-b2c9eef1e2dc"
      }
    },
    "owner": "nadhir_off"
  }
}

# En développement, l'adresse de l'API est trouvée automatiquement (IP du PC qui lance « npx expo start »).
# Port du backend PHP (php -S 0.0.0.0:8000 -t public public/index.php) :
EXPO_PUBLIC_API_PORT=8000
# Seulement pour un serveur en ligne (production) :
# EXPO_PUBLIC_API_URL=https://api.mon-domaine.bj
